PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hikmah-it
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# Seeded on first server start if no admin account exists yet.
# Change the password immediately after first login, or use it once then
# switch to the forgot-password flow.
ADMIN_EMAIL=admin@hikmahit.com
ADMIN_PASSWORD=change-this-strong-password

# Leave empty to just log the reset link to the server console instead of emailing.
RESEND_API_KEY=
EMAIL_FROM=Hikmah IT <onboarding@resend.dev>

# Leave all three empty to keep uploading images to local /uploads storage instead of Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer mobile OTP delivery (signup/verification) via RT Com (rtcom.xyz) "One to Many" SMS API.
# Leave these empty to just log the OTP to the server console instead of sending a real SMS.
SMS_API_URL=https://api.rtcom.xyz/onetomany
SMS_ACCOUNT_CODE=
SMS_API_KEY=
SMS_SENDER_ID=
